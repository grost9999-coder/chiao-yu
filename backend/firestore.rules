rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && !exists(/databases/$(database)/documents/ledgerDeletion/$(uid));
    }
    function metadata() {
      return request.resource.data.keys().hasOnly(['revision','chunks','digest','bytes','updatedAt','format'])
        && request.resource.data.revision is string
        && request.resource.data.revision.matches('^[0-9A-Fa-f-]{36}$')
        && request.resource.data.chunks is int && request.resource.data.chunks >= 1 && request.resource.data.chunks <= 120
        && request.resource.data.digest is string && request.resource.data.digest.matches('^[0-9a-f]{64}$')
        && request.resource.data.bytes is int && request.resource.data.bytes > 0 && request.resource.data.bytes <= 25000000
        && request.resource.data.format == 1 && request.resource.data.updatedAt == request.time;
    }
    match /ledgerAccounts/{uid} {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && metadata()
        && exists(/databases/$(database)/documents/ledgerAccounts/$(uid)/snapshots/$(request.resource.data.revision));
      allow list, delete: if false;
      match /snapshots/{revision} {
        allow read: if owner(uid);
        allow create: if owner(uid) && metadata() && request.resource.data.revision == revision;
        allow update, delete: if false;
        match /chunks/{chunk} {
          allow read: if owner(uid);
          allow create: if owner(uid) && revision.matches('^[0-9A-Fa-f-]{36}$')
            && chunk.matches('^[0-9]{1,3}$')
            && request.resource.data.keys().hasOnly(['payload'])
            && request.resource.data.payload is string && request.resource.data.payload.size() <= 400000;
          allow update, delete: if false;
        }
      }
    }
    // Kept for seven days after deletion to block writes using cached ID tokens.
    // Configure TTL on expiresAt; client reads and writes are forbidden.
    match /ledgerDeletion/{uid} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
